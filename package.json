{
  "name": "youtube-idea-factory",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/next-realpath.cjs dev",
    "build": "node scripts/next-realpath.cjs build",
    "start": "node scripts/next-realpath.cjs start",
    "test": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/*.test.mts",
    "ops:status": "node scripts/ops-status.mjs",
    "ops:worker-doctor": "node scripts/worker-doctor.mjs",
    "render:worker": "node scripts/render-worker.mjs",
    "youtube:upload-worker": "node scripts/youtube-upload-worker.mjs",
    "typecheck": "node scripts/next-realpath.cjs typegen && tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "1.14.0",
    "next": "^16.3.3",
    "react": "19.2.5",
    "react-dom": "19.2.5"
  },
  "overrides": {
    "postcss": "8.5.26"
  },
  "devDependencies": {
    "@types/node": "24.10.2",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  }
}
