YOUTUBE_API_KEY=
DASHBOARD_ADMIN_TOKEN=
DASHBOARD_ADMIN_USERNAME=admin
DASHBOARD_ADMIN_PASSWORD=
DASHBOARD_ADMIN_EMAIL=
DASHBOARD_SESSION_SECRET=
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REFRESH_TOKEN=
SUPADATA_API_KEY=

# Deployment / storage
# Optional fail-closed guard for CLI production deployment target validation.
EXPECTED_VERCEL_PROJECT_ID=
# local: filesystem-backed harness work
# supabase: durable dashboard state on Vercel
APP_STORAGE_MODE=local
NEXT_PUBLIC_SUPABASE_URL=
# Preferred browser-safe key for current Supabase projects (sb_publishable_...).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy JWT key fallback. Leave empty when the publishable key is configured.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Preferred server-only key for current Supabase projects (sb_secret_...).
SUPABASE_SECRET_KEY=
# Legacy JWT key fallback. Leave empty when SUPABASE_SECRET_KEY is configured.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ASSETS_BUCKET=youtube-assets
